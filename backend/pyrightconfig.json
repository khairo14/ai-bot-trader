{
  "venvPath": ".",
  "venv": ".venv",
  "pythonVersion": "3.11",
  "include": ["."],
  "exclude": [".venv", "**/__pycache__", "dist", "**/node_modules", "**/.*", "**/node_modules", "**/.*"],
  "reportMissingModuleSource": "none",
  "reportMissingImports": "warning",
  "typeCheckingMode": "basic",
  "reportReturnType": "none"
}
