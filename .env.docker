# ─────────────────────────────────────────────────────────────────────────────
# AI Bot Trader — Docker Environment Template
#
# USAGE:
#   Copy this file to .env before running the Docker bundle:
#       copy .env.docker .env          (Windows CMD)
#       Copy-Item .env.docker .env     (PowerShell)
#
#   Then fill in your broker API keys below.
#   The launch scripts do this automatically on first run.
#
# NOTE: Host names (db, redis) are Docker service names — do not change them.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────
SECRET_KEY=change_this_to_a_random_64_char_string
DEBUG=false
LOG_LEVEL=INFO
# COOKIE_SECURE: set to false for local HTTP (localhost). Set to true only when
# serving over HTTPS (e.g. on a VPS with a domain + TLS certificate).
# Secure cookies are silently dropped by browsers on plain HTTP, breaking login.
COOKIE_SECURE=false

# ── Proxy (leave blank in Docker — system proxy on host is not reachable inside containers)
HTTP_PROXY=
HTTPS_PROXY=

# ── Database (Docker service name = "db") ────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=trader
POSTGRES_PASSWORD=trader_password
POSTGRES_DB=ai_trader
DATABASE_URL=postgresql://trader:trader_password@db:5432/ai_trader

# ── Redis (Docker service name = "redis") ────────────────
REDIS_URL=redis://redis:6379/0

# ── Binance ──────────────────────────────────────────────
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_TESTNET=false

# ── Alpaca ───────────────────────────────────────────────
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_API_SECRET=your_alpaca_api_secret_here
# Paper trading URL — change to https://api.alpaca.markets for live
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_FEED=iex

# ── Interactive Brokers (IBKR) ───────────────────────────
# Docker: IBKR Gateway runs on the HOST machine, not inside Docker.
# host.docker.internal resolves to the host from inside a container.
IBKR_HOST=host.docker.internal
# 7497 = paper trading, 7496 = live trading
IBKR_PORT=7497
IBKR_CLIENT_ID=1
IBKR_PAPER=true

# ── Paper Trading ────────────────────────────────────────
PAPER_INITIAL_BALANCE=10000.00

# ── Risk Management ──────────────────────────────────────
RISK_PER_TRADE_PCT=2.0
MAX_OPEN_POSITIONS=5
DAILY_CIRCUIT_BREAKER_PCT=5.0
MAX_DAILY_LOSS_PER_STRATEGY_PCT=5.0
MAX_CONSECUTIVE_LOSSES=3
MAX_EXPOSURE_PER_ASSET_PCT=15.0
MAX_EXPOSURE_PER_CLASS_PCT=40.0
DEFAULT_RR_RATIO=2.0
ATR_STOP_MULTIPLIER=2.0

# ── Auto-Scheduler ───────────────────────────────────────
FORWARD_TEST_INTERVAL_MINUTES=1

# ── ML / AI ──────────────────────────────────────────────
OPENAI_API_KEY=

# ── CORS ─────────────────────────────────────────────────
# Port 3000 = nginx frontend container (Docker bundle)
CORS_ORIGINS=http://localhost:3000
