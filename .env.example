# ── Application ──────────────────────────────────────────
SECRET_KEY=change_this_to_a_random_64_char_string
DEBUG=false
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────
# Local dev (Python venv): use localhost
# Full Docker stack: use the service name "db"
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=trader
POSTGRES_PASSWORD=change_this_password
POSTGRES_DB=ai_trader
DATABASE_URL=postgresql://trader:change_this_password@localhost:5432/ai_trader

# ── Redis ────────────────────────────────────────────────
# Local dev: redis://localhost:6379/0
# Full Docker: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0

# ── Binance ──────────────────────────────────────────────
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_TESTNET=false
# If running behind a VPN, route Binance API calls through the VPN's local proxy.
# Remove or comment out the line below if not using a VPN.
# HTTP_PROXY=http://127.0.0.1:61892

# ── Alpaca ───────────────────────────────────────────────
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_API_SECRET=your_alpaca_api_secret_here
# Paper trading URL (change to https://api.alpaca.markets for live)
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_FEED=iex

# ── Interactive Brokers (IBKR) ───────────────────────────
# Local dev (Python venv): IBKR_HOST=127.0.0.1
# Full Docker stack:       IBKR_HOST=host.docker.internal
IBKR_HOST=127.0.0.1
# 7497 = paper trading, 7496 = live trading
IBKR_PORT=7497
IBKR_CLIENT_ID=1
IBKR_PAPER=true
# IMPORTANT: In IB Gateway settings, Read-Only API must be OFF (unticked)

# ── Paper Trading ────────────────────────────────────────
PAPER_INITIAL_BALANCE=10000.00

# ── Risk Management ──────────────────────────────────────
RISK_PER_TRADE_PCT=2.0
MAX_OPEN_POSITIONS=5
DAILY_CIRCUIT_BREAKER_PCT=5.0
MAX_DAILY_LOSS_PER_STRATEGY_PCT=5.0
MAX_CONSECUTIVE_LOSSES=3
MAX_EXPOSURE_PER_ASSET_PCT=15.0
MAX_EXPOSURE_PER_CLASS_PCT=40.0
DEFAULT_RR_RATIO=2.0
ATR_STOP_MULTIPLIER=2.0

# ── ML / AI ──────────────────────────────────────────────
# Optional: OpenAI key for LLM-assisted signal reasoning (future feature)
OPENAI_API_KEY=

# ── CORS ─────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
